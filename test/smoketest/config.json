{
    "root": {
        "elos": {
            "UseEnv": true,
            "ConnectionLimit": 200,
            "LogLevel": "DEBUG",
            "Port": 54323,
            "LogFilter": "",
            "EventBlacklist": ".event.messageCode 2000 EQ",
            "authorizedProcesses": [
                ".process.uid 0 EQ .process.gid 0 EQ .process.exec '/bin/elosc' STRCMP AND",
                ".process.gid 200 EQ .process.exec '/bin/elosc' STRCMP AND",
                ".process.pid 1 EQ"
            ],
            "ClientInputs": {
                "Plugins": {
                    "LocalTcpClient": {
                        "File": "client_dummy.so",
                        "Run": "always"
                    },
                    "PublicTcpClient": {
                        "File": "client_dummy.so",
                        "Run": "always"
                    },
                    "TCP that the smoketest can know elosd is running": {
                        "File": "client_tcp.so",
                        "Run": "always",
                        "Config": {
                            "ConnectionLimit": 200,
                            "Port": 54323,
                            "Interface": "127.0.0.1",
                            "EventBlacklist": ".event.messageCode 2000 EQ",
                            "authorizedProcesses": [
                                ".process.uid 0 EQ .process.gid 0 EQ .process.exec '/bin/elosc' STRCMP AND",
                                ".process.gid 200 EQ .process.exec '/bin/elosc' STRCMP AND",
                                ".process.pid 1 EQ"
                            ]
                        }
                    }
                }
            },
            "EventLogging": {
                "Plugins": {
                    "DummyBackend": {
                        "File": "backend_dummy.so",
                        "Run": "always",
                        "Filter": [
                            "1 1 EQ"
                        ]
                    },
                    "fetchapi": {
                        "File": "backend_ring_buffer.so",
                        "Run": "always",
                        "Filter": [
                            "1 1 EQ"
                        ],
                        "Config": {
                            "BufferSize": 5
                        }
                    }
                }
            },
            "Scanner": {
                "Plugins": {
                    "RustScannerDummy": {
                        "File": "scanner_rust_dummy.so",
                        "Run": "always",
                        "Config": { }
                    },
                    "HighLoadWarning": {
                        "File": "scanner_load_warning.so",
                        "Run": "always",
                        "Config": {
                            "Interval": { "Seconds": 1, "MilliSeconds": 0, "MicroSeconds": 0, "NanoSeconds": 0 },
                            "AvgTimeframe": "One",
                            "Thresholds": {
                                "Info": [0.4,1,2,3],
                                "Warn": [4.0,5,6.0,7]
                            },
                            "Epsilon": 0.1
                        }
                    }
                }
            }
        }
    }
}
